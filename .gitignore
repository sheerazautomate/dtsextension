# =============================================================================
# DTS Extension — Master .gitignore
# =============================================================================
# Everything NOT listed here is tracked by git.
# Always keep .example files and .gitignore itself.
#
# Order matters: negation patterns (!) must come AFTER the pattern they override.

# ── Dependencies (all node_modules anywhere in the repo) ─────────────────────
node_modules/
**/node_modules/

# ── Build output ────────────────────────────────────────────────────────────
.next/
.next/**/
dist/
build/
out/
admin-panel/.next/
admin-panel/.vercel/

# ── Environment / secrets — keep only .example files ────────────────────────
.env
.env.local
.env.*
!.env.example
!.env.local.example
!.env.*.example

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
.atom/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ── Test coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── Archives ────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ── Temporary ───────────────────────────────────────────────────────────────
.tmp/
.tmp
*.tmp
temp/
tmp/

# ── Package lock files ──────────────────────────────────────────────────────
yarn.lock
pnpm-lock.yaml

# =============================================================================
# NEVER COMMIT — Secrets, PII, session keys, and runtime artifacts
# =============================================================================

# ── clasp local project id ──────────────────────────────────────────────────
.clasp.json
.clasp.local.json

# ── WhatsApp session keys (live Baileys auth) ───────────────────────────────
whatsapp-bot/auth_info/
whatsapp-bot/backup2.0/auth_info/
**/auth_info/

# ── Bot runtime / PII data ──────────────────────────────────────────────────
whatsapp-bot/chat_history.json
whatsapp-bot/known_contacts.json
whatsapp-bot/scheduled_messages.json
whatsapp-bot/backup2.0/chat_history.json
whatsapp-bot/backup2.0/known_contacts.json
whatsapp-bot/backup2.0/scheduled_messages.json
whatsapp-bot/scheduled-attachments/
whatsapp-bot/backup2.0/scheduled-attachments/

# ── Cloudflare tunnel artifacts ─────────────────────────────────────────────
whatsapp-bot/cloudflare
whatsapp-bot/backup2.0/cloudflare
whatsapp-bot/get groups
whatsapp-bot/backup2.0/get groups
/tmp/cloudflared.log
/tmp/cloudflared.pid
/tmp/cloudflared.url
/tmp/cloudflared.restart
/tmp/cloudflared.start_ts
cloudflare/

# ── Generated PDF bills ─────────────────────────────────────────────────────
whatsapp-bot/bills/
whatsapp-bot/backup2.0/bills/
**/bills/
*.pdf

# ── Entire backup directory ─────────────────────────────────────────────────
whatsapp-bot/backup2.0/

# ── Standalone utility / diagnostic scripts ─────────────────────────────────
whatsapp-bot/get-groups.js
whatsapp-bot/backup2.0/get-groups.js
whatsapp-bot/index.js
whatsapp-bot/backup2.0/index.js

# ── Admin panel build artifacts ─────────────────────────────────────────────
admin-panel/.next/
admin-panel/.vercel/

# ── PM2 runtime ─────────────────────────────────────────────────────────────
*.dump
pm2-*

# ── Miscellaneous ───────────────────────────────────────────────────────────
*.min.js
*.map

# =============================================================================
# Keep .example files always (must come AFTER matching ignore patterns)
# =============================================================================
!.env.example
!.env.local.example
!.env.*.example
!.clasp.json.example
!whatsapp-bot/.env.example
!admin-panel/.env.example
