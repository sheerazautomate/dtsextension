# Admin Panel Configuration
# Copy this file to .env.local and fill in your values.
# IMPORTANT: .env files are gitignored — never commit secrets.

# Google Apps Script Web App URL (the one deployed from backend/)
APPS_SCRIPT_URL=

# Must match the SHARED_SECRET in Code.gs
APPS_SCRIPT_SECRET=

# Local bot URL (only needed when running admin panel on the same machine as the bot)
LOCAL_BOT_URL=http://localhost:3000

# Secret for accessing /diagnostics on the local bot
LOCAL_BOT_SECRET=

# Path to cloudflared log file (for local diagnostics)
LOCAL_CLOUDFLARED_LOG=/tmp/cloudflared.log
