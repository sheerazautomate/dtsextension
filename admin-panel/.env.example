# The deployed Apps Script Web App /exec URL (Code.gs)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwhuxqihQeDPgNxWsJ97dRKolqh44VMvEXekHi8SNShsWCaPGbqLvazGYaqq7wunttSMQ/exec

# Must match SHARED_SECRET in Code.gs — kept server-side only, never sent to the browser.
APPS_SCRIPT_SECRET=arsh7999
# Optional. Only meaningful when running the panel locally (npm run dev) on
# the same machine as whatsapp-bot — used by the Local Diagnostics panel to
# hit the bot directly over localhost, bypassing the tunnel/Apps Script.
LOCAL_BOT_URL=http://localhost:3000
LOCAL_BOT_SECRET=arsh7999
LOCAL_CLOUDFLARED_LOG=/tmp/cloudflared.log
