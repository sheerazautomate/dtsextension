# WhatsApp Bot Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: .env files are gitignored — never commit secrets.

# Port for the Express webhook server
PORT=3000

# Target WhatsApp group JID (use get-groups.js to find yours)
WHATSAPP_GROUP_JID=

# Shared secret for /send-file and /diagnostics endpoints
# Must match the SHARED_SECRET in your Apps Script Code.gs
WHATSAPP_SHARED_SECRET=

# Apps Script Web App URL (for heartbeat/command polling)
APPS_SCRIPT_URL=

# Apps Script secret (must match SHARED_SECRET in Code.gs)
APPS_SCRIPT_SECRET=
