# WhatsApp Bot Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: .env files are gitignored — never commit secrets.

# Port for the Express webhook server
PORT=3000

# Target WhatsApp group JID (use get-groups.js to find yours)
WHATSAPP_GROUP_JID=

# Shared secret for /send-file and /diagnostics endpoints
# Must match the SHARED_SECRET in your Apps Script Code.gs
WHATSAPP_SHARED_SECRET=

# Apps Script Web App URL (for heartbeat/command polling)
APPS_SCRIPT_URL=

# Apps Script admin-panel secret (must match AdminPanel.js ADMIN_PANEL_SECRET)
# Used by server.js heartbeats and tunnel.sh command polling / ack.
APPS_SCRIPT_SECRET=

# Secret for POSTing a new tunnel URL into waUrlRegistry.js.
# Must match URL_UPDATE_SECRET in Apps Script. If unset, tunnel.sh falls
# back to APPS_SCRIPT_SECRET. If the admin panel never shows a new URL
# even though pm2 logs "Reported URL", these two secrets do not match.
URL_UPDATE_SECRET=
