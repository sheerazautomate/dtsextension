# WhatsApp Bot Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: .env is gitignored — never commit it.
#
# Generate secrets with: openssl rand -hex 24
# Do not reuse arsh7999 / blahblah — those were committed and are burned.

# Port for the Express webhook server
PORT=3000

# Target WhatsApp group JID (run: node get-groups.js)
WHATSAPP_GROUP_JID=

# Shared secret for /send-file and /diagnostics
# Must match Apps Script property WHATSAPP_SHARED_SECRET
WHATSAPP_SHARED_SECRET=

# Apps Script Web App URL (the /exec deployment)
APPS_SCRIPT_URL=

# Must match Apps Script property ADMIN_PANEL_SECRET
# Used by server.js heartbeats and tunnel.sh command polling / ack.
APPS_SCRIPT_SECRET=

# Must match Apps Script property URL_UPDATE_SECRET
# Used when tunnel.sh POSTs a new trycloudflare.com URL.
URL_UPDATE_SECRET=
